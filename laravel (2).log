9. وقع الطرفان على هذا العقد بما يفيد اعتماده والعمل بما جاء فيه من أحكام وشروط من تاريخ إبرامه.","status":"نشط","authorized_documents":"[\"تأمين سيارات إجباري\",\"تأمين سيارات دولي\",\"كشف حساب الوكيل\"]","document_percentages":"{\"تأمين سيارات إجباري\":0,\"تأمين سيارات\":30,\"تأمين سيارات دولي\":30,\"كشف حساب الوكيل\":0}","lifo_office_id":"1344"}} 
